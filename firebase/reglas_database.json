{
  "rules": {
    ".read": false,
    ".write": false,

    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "perfil": {
          ".validate": "newData.hasChildren(['nombre', 'correo', 'creado'])",
          "nombre": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
          "correo": { ".validate": "newData.isString() && newData.val() === auth.token.email" },
          "creado": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$otro": { ".validate": false }
        },
        "centrales": {
          "$c": { ".validate": "newData.val() === true && (root.child('centrales/' + $c + '/miembros/' + $uid).exists() || newData.parent().parent().parent().parent().child('centrales/' + $c + '/miembros/' + $uid).exists())" }
        },
        "$otro": { ".validate": false }
      }
    },

    "centrales": {
      "$c": {
        ".read": "auth != null && data.child('miembros/' + auth.uid).exists()",

        "info": {
          "nombre": {
            ".write": "auth != null && root.child('centrales/' + $c + '/info/propietario').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "propietario": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid && root.child('codigosVinculacion/' + $c).exists() && newData.parent().parent().child('miembros/' + auth.uid + '/codigo').val() === root.child('codigosVinculacion/' + $c).val()"
          }
        },

        "miembros": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && !data.exists() && root.child('codigosVinculacion/' + $c).exists() && newData.child('codigo').val() === root.child('codigosVinculacion/' + $c).val()) || (!newData.exists() && auth.uid === $uid && root.child('centrales/' + $c + '/info/propietario').val() !== auth.uid) || (!newData.exists() && auth.uid !== $uid && root.child('centrales/' + $c + '/info/propietario').val() === auth.uid))",
            ".validate": "newData.hasChildren(['correo', 'codigo', 'unido'])",
            "correo": { ".validate": "newData.isString() && newData.val() === auth.token.email" },
            "codigo": { ".validate": "newData.isString()" },
            "unido": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$otro": { ".validate": false }
          }
        },

        "estado": {
          "armado": {
            ".write": "auth != null && root.child('centrales/' + $c + '/miembros/' + auth.uid).exists()",
            ".validate": "newData.isBoolean()"
          },
          "alerta": {
            ".write": "auth != null && root.child('centrales/' + $c + '/miembros/' + auth.uid).exists()",
            ".validate": "newData.val() === false"
          },
          "desactivacion": {
            ".write": "auth != null && root.child('centrales/' + $c + '/miembros/' + auth.uid).exists()",
            ".validate": "newData.child('origen').val() === 'app' && newData.child('uid').val() === auth.uid && newData.child('fecha').isNumber() && newData.child('fecha').val() <= now"
          }
        },

        "config": {
          "horario": {
            ".write": "auth != null && root.child('centrales/' + $c + '/info/propietario').val() === auth.uid",
            ".validate": "newData.hasChildren(['siempre', 'inicio', 'fin'])",
            "siempre": { ".validate": "newData.isBoolean()" },
            "inicio": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1439" },
            "fin": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1439" },
            "$otro": { ".validate": false }
          }
        },

        "nodos": {
          "$n": {
            ".write": "auth != null && root.child('centrales/' + $c + '/info/propietario').val() === auth.uid && $n.matches(/^[A-Z0-9]{2,8}$/)",
            ".validate": "newData.hasChildren(['nombre', 'tipo', 'activo'])",
            "nombre": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30" },
            "tipo": { ".validate": "newData.val() === 'pir'" },
            "activo": { ".validate": "newData.isBoolean()" },
            "creado": { ".validate": "newData.isNumber() && (newData.val() === data.val() || (!data.exists() && newData.val() <= now))" },
            "descubierto": { ".validate": "newData.isBoolean()" },
            "ultimoContacto": { ".validate": "newData.val() === data.val()" },
            "$otro": { ".validate": false }
          }
        },

        "historial": {
          ".indexOn": ["fecha", "nodo"],
          ".write": "auth != null && !newData.exists() && root.child('centrales/' + $c + '/info/propietario').val() === auth.uid",
          "$id": {
            ".write": "auth != null && !newData.exists() && root.child('centrales/' + $c + '/info/propietario').val() === auth.uid"
          }
        }
      }
    }
  }
}
