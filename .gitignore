# Claves de Wi-Fi y Firebase de la central: nunca subirlas
firmware/central/secretos.h

# Llaves de firma de la app
app/android/key.properties
*.jks
*.keystore
app/android/llave/

# APK compilada (se publica aparte, en Releases)
*.apk

# Registros de Firebase CLI
firebase/herramientas/registro.txt
firebase-debug.log
database-debug.log

# APKs entregados (se generan con flutter build apk); no se suben
entregas/

# Archivos temporales del compilador de Kotlin
app/android/.kotlin/

# Grafo de conocimiento (graphify): se suben graph.json, GRAPH_REPORT.md y graph.html;
# la caché y las rutas locales de este PC no
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cost.json
